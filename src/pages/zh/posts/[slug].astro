---
import type { CollectionEntry } from 'astro:content';
import PostPage from '../../../components/pages/PostPage.astro';
import { getPublicSlug, getPublishedPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const [posts, translations] = await Promise.all([getPublishedPosts('zh'), getPublishedPosts('en')]);
  const allPosts = [...posts, ...translations];
  return posts.map((post) => ({
    params: { slug: getPublicSlug(post.id) },
    props: { post, posts, allPosts },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  posts: CollectionEntry<'posts'>[];
  allPosts: CollectionEntry<'posts'>[];
}

const { post, posts, allPosts } = Astro.props;
---

<PostPage locale="zh" post={post} posts={posts} allPosts={allPosts} />
