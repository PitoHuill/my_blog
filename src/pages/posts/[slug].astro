---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { posts } from '../../data/site';
export function getStaticPaths(){return posts.map((post)=>({params:{slug:post.slug},props:{post}}));}
const { post } = Astro.props; const index=posts.findIndex((item)=>item.slug===post.slug); const prev=posts[index+1]; const next=posts[index-1];
---
<BaseLayout title={`${post.title} · 你的名字`} description={post.description}><article class="shell article"><a class="back" href="/posts/">← 全部文章</a><p class="eyebrow">ARTICLE</p><h1>{post.title}</h1><div class="meta">{post.date} · {Math.max(1, Math.ceil(post.body.join('').length / 350))} 分钟阅读{post.tags.map((tag) => <a class="tag" href={`/posts/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div><p class="lead">{post.description}</p>{post.body.map((paragraph) => <p>{paragraph}</p>)}<hr /><nav class="article-nav" aria-label="文章导航">{prev ? <a href={`/posts/${prev.slug}/`}>← 上一篇<br /><b>{prev.title}</b></a> : <span />}{next ? <a href={`/posts/${next.slug}/`}>下一篇 →<br /><b>{next.title}</b></a> : <span />}</nav></article></BaseLayout>
<style>.article{max-width:740px;padding-top:54px}.back{font-size:.85rem}.article h1{font:2.35rem/1.3 Georgia,"Noto Serif SC",serif;margin:.7rem 0}.lead{font-size:1.1rem!important;color:var(--color-muted);border-left:2px solid var(--color-accent);padding-left:16px}.article p{font-size:1rem;line-height:2;margin:1.35rem 0}.article hr{border:0;border-top:1px solid var(--color-border);margin:3rem 0}.article-nav{display:grid;grid-template-columns:1fr 1fr;gap:20px}.article-nav a:last-child{text-align:right}.article-nav b{font:1rem Georgia;color:var(--color-text)}@media(max-width:767px){.article{padding-top:32px}.article h1{font-size:1.8rem}}</style>
