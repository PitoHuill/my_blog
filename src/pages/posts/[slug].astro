---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { profile } from '../../data/site';
import { calculateReadingTime, getAdjacentPosts, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  posts: CollectionEntry<'posts'>[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { previous, next } = getAdjacentPosts(posts, post.id);
const readingTime = calculateReadingTime(post.body ?? '');
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<BaseLayout title={`${post.data.title} · ${profile.name}`} description={post.data.description}>
  <article class="shell article">
    <a class="back" href={href('posts/')}>← 全部文章</a>
    <p class="eyebrow">ARTICLE</p>
    <h1>{post.data.title}</h1>
    <div class="meta">
      {formatDate(post.data.pubDate)} · {readingTime} 分钟阅读
      {post.data.tags.map((tag) => (
        <a class="tag" href={`${href('posts/')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
      ))}
    </div>
    {post.data.series && (
      <p class="series-note">
        系列：{post.data.series}{post.data.seriesOrder ? ` · 第 ${post.data.seriesOrder} 篇` : ''}
      </p>
    )}
    <p class="lead">{post.data.description}</p>
    <TableOfContents headings={headings} />
    <div class="article-content"><Content /></div>
    <hr />
    <nav class="article-nav" aria-label="文章导航">
      {previous
        ? <a href={href(`posts/${previous.id}/`)}>← 上一篇<br /><b>{previous.data.title}</b></a>
        : <span />}
      {next
        ? <a href={href(`posts/${next.id}/`)}>下一篇 →<br /><b>{next.data.title}</b></a>
        : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .article{max-width:740px;padding-top:54px}.back{font-size:.85rem}.article h1{font:2.35rem/1.3 Georgia,"Noto Serif SC",serif;margin:.7rem 0}.series-note{display:inline-block;margin:1rem 0 0;padding:.35rem .65rem;background:var(--color-soft);border:1px solid var(--color-border);border-radius:4px;color:var(--color-accent);font-size:.82rem}.lead{font-size:1.1rem;color:var(--color-muted);border-left:2px solid var(--color-accent);padding-left:16px}.article hr{border:0;border-top:1px solid var(--color-border);margin:3rem 0}.article-nav{display:grid;grid-template-columns:1fr 1fr;gap:20px}.article-nav a:last-child{text-align:right}.article-nav b{font:1rem Georgia;color:var(--color-text)}@media(max-width:767px){.article{padding-top:32px}.article h1{font-size:1.8rem}}
</style>
