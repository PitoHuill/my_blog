---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, profile, projects } from '../data/site';
const featured = posts.find((post) => post.featured); const recent = posts.filter((post) => !post.featured).slice(0, 3);
---
<BaseLayout title={`${profile.name} · 个人博客`} description={profile.tagline}>
  <div class="shell home-grid"><aside><section class="profile card"><div class="avatar">你</div><h1>{profile.name}</h1><p>{profile.tagline}<br />{profile.bio}</p><div class="social"><a href={profile.github}>GitHub ↗</a><a href={`mailto:${profile.email}`}>邮箱 ↗</a></div></section><section class="stats card"><div><b>{posts.length}</b><span>文章</span></div><div><b>{projects.length}</b><span>项目</span></div><div><b>3</b><span>成果</span></div></section><section class="sidebar-card card"><h2>精选链接</h2><a href="/about/">关于我 →</a><a href="/projects/">全部项目 →</a><a href="/rss.xml">RSS 订阅 →</a></section></aside><section class="home-main">{featured && <><div class="section-heading">精选文章</div><article class="post-card feature card"><span class="eyebrow">FEATURED</span><h2><a href={`/posts/${featured.slug}/`}>{featured.title}</a></h2><div class="meta">{featured.date}{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div><p>{featured.description}</p></article></>}<a class="now card" href="/about/#now"><b>Now</b><span>{profile.now}</span><em>→</em></a><div class="section-heading">最新文章 <a href="/posts/">全部 →</a></div>{recent.map((post) => <article class="post-card card"><h2><a href={`/posts/${post.slug}/`}>{post.title}</a></h2><div class="meta">{post.date}{post.tags.map((tag) => <span class="tag">{tag}</span>)}</div><p>{post.description}</p></article>)}<div class="section-heading project-heading">项目 <a href="/projects/">全部 →</a></div>{projects.slice(0, 2).map((project) => <article class="post-card card"><h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2><div class="meta">{project.year} · {project.status}</div><p>{project.description}</p></article>)}</section></div>
</BaseLayout>
<style>.home-grid{display:grid;grid-template-columns:260px minmax(0,1fr);gap:32px;padding-top:34px}.profile,.sidebar-card{padding:22px}.avatar{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;margin:auto;background:linear-gradient(140deg,var(--color-accent),var(--color-soft));color:white;font-family:Georgia}.profile h1{text-align:center;font:1.3rem Georgia;margin:12px 0 8px}.profile p{color:var(--color-muted);font-size:.85rem;line-height:1.7;text-align:center}.social{display:flex;justify-content:center;gap:14px;font-size:.8rem}.stats{display:grid;grid-template-columns:repeat(3,1fr);padding:17px;margin-top:14px;text-align:center}.stats b{display:block;color:var(--color-accent);font:1.35rem Georgia}.stats span{font-size:.75rem;color:var(--color-muted)}.sidebar-card{margin-top:14px}.sidebar-card h2{font:1rem Georgia;margin:0 0 .6rem}.sidebar-card a{display:block;padding:.45rem 0;font-size:.85rem}.post-card{padding:20px 21px;margin-bottom:13px;transition:transform .2s,border-color .2s}.post-card:hover{transform:translateY(-2px);border-color:var(--color-accent)}.post-card h2{margin:.1rem 0 .65rem;font:1.08rem/1.45 Georgia,"Noto Serif SC",serif}.post-card h2 a{color:var(--color-text)}.post-card p{margin:.8rem 0 0;color:var(--color-muted);font-size:.88rem;line-height:1.7}.feature h2{font-size:1.25rem}.now{display:flex;gap:13px;align-items:center;padding:15px 18px;margin:25px 0;border-left:2px solid var(--color-accent);color:var(--color-muted);font-size:.88rem}.now b{color:var(--color-text);font-family:Georgia}.now em{margin-left:auto;color:var(--color-accent);font-style:normal}.project-heading{margin-top:32px}@media(max-width:767px){.home-grid{grid-template-columns:1fr;padding-top:20px}.home-grid aside{display:grid;grid-template-columns:1fr 1fr;gap:12px}.profile{grid-column:1/-1}.stats,.sidebar-card{margin:0}}</style>
