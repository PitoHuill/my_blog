---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import { profile } from '../data/site';
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { localizedPath } from '../lib/paths';

interface Props {
  locale: Locale;
  counterpartUrl?: string;
}

const { locale, counterpartUrl } = Astro.props;
const labels = ui[locale].navigation;
const href = (path: string) => localizedPath(path, locale);
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const homePath = normalizePath(href(''));
const navItems = [
  { label: labels.home, path: '', matches: [href('')] },
  { label: labels.posts, path: 'posts/', matches: [href('posts/'), href('series/')] },
  { label: labels.projects, path: 'projects/', matches: [href('projects/')] },
  { label: labels.about, path: 'about/', matches: [href('about/')] },
];
const isCurrent = (matches: string[]) => matches.some((path) => {
  const target = normalizePath(path);
  return currentPath === target || (target !== homePath && currentPath.startsWith(`${target}/`));
});
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href('')}><span>◒</span>{profile.name}</a>
    <nav aria-label={locale === 'en' ? 'Primary navigation' : '主导航'}>
      {navItems.map((item) => (
        <a href={href(item.path)} aria-current={isCurrent(item.matches) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <ThemeToggle locale={locale} />
    <LanguageToggle locale={locale} counterpartUrl={counterpartUrl} />
  </div>
</header>
