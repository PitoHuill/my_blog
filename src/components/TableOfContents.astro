---
import type { MarkdownHeading } from 'astro';
import type { Locale } from '../i18n/config';

interface Props {
  headings: MarkdownHeading[];
  locale: Locale;
}

const { headings, locale } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <nav class="table-of-contents" aria-label={locale === 'en' ? 'Table of contents' : '文章目录'}>
    <strong>{locale === 'en' ? 'Contents' : '目录'}</strong>
    <ol>
      {items.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .table-of-contents{padding-top:16px;border-top:1px solid var(--color-border)}
  .table-of-contents strong{font:.95rem Georgia,"Noto Serif SC",serif}
  .table-of-contents ol{list-style:none;margin:12px 0 0;padding:0}
  .table-of-contents li{margin:8px 0;font-size:.82rem;line-height:1.5}
  .table-of-contents li.nested{padding-left:12px}
  .table-of-contents a{color:var(--color-muted)}
  .table-of-contents a:hover{color:var(--color-accent)}
  @media(max-width:1023px){.table-of-contents{padding:16px 0;border-bottom:1px solid var(--color-border)}.table-of-contents ol{columns:1}}
  @media(max-width:767px){.table-of-contents li.nested{padding-left:0}}
</style>
