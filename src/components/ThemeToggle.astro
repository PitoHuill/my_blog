---
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lightLabel = locale === 'en' ? 'Switch to light theme' : '切换至日间主题';
const darkLabel = locale === 'en' ? 'Switch to dark theme' : '切换至夜间主题';
---

<button
  class="theme-toggle"
  type="button"
  aria-label={darkLabel}
  title={darkLabel}
  data-light-label={lightLabel}
  data-dark-label={darkLabel}
>
  <span aria-hidden="true">☾</span>
</button>
<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    const icon = button.querySelector('span');
    const setTheme = (theme: 'light' | 'dark') => {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      if (icon) icon.textContent = theme === 'dark' ? '☀' : '☾';
      const label = theme === 'dark' ? button.dataset.lightLabel : button.dataset.darkLabel;
      if (label) {
        button.setAttribute('aria-label', label);
        button.title = label;
      }
    };
    setTheme((document.documentElement.dataset.theme as 'light' | 'dark') || 'light');
    button.addEventListener('click', () => {
      setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  });
</script>
