---
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lightLabel = locale === 'en' ? 'Switch to light theme' : '切换至日间主题';
const darkLabel = locale === 'en' ? 'Switch to dark theme' : '切换至夜间主题';
---

<button
  class="theme-toggle"
  type="button"
  aria-label={darkLabel}
  aria-pressed="false"
  title={darkLabel}
  data-light-label={lightLabel}
  data-dark-label={darkLabel}
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__stars">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="theme-toggle__clouds">
      <span class="theme-toggle__cloud theme-toggle__cloud--back"></span>
      <span class="theme-toggle__cloud theme-toggle__cloud--front"></span>
    </span>
    <span class="theme-toggle__knob">
      <span class="theme-toggle__crater theme-toggle__crater--large"></span>
      <span class="theme-toggle__crater theme-toggle__crater--small"></span>
      <span class="theme-toggle__crater theme-toggle__crater--tiny"></span>
    </span>
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    const setTheme = (theme: 'light' | 'dark') => {
      const isDark = theme === 'dark';
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      button.setAttribute('aria-pressed', String(isDark));

      const label = isDark ? button.dataset.lightLabel : button.dataset.darkLabel;
      if (label) {
        button.setAttribute('aria-label', label);
        button.title = label;
      }
    };

    setTheme((document.documentElement.dataset.theme as 'light' | 'dark') || 'light');
    button.addEventListener('click', () => {
      setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  });
</script>

<style>
  .theme-toggle {
    --toggle-knob-size: 24px;
    --toggle-travel: 34px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 72px;
    height: 44px;
    margin-left: .75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-toggle__track {
    position: relative;
    display: block;
    width: 64px;
    height: 30px;
    overflow: hidden;
    border: 1px solid #b9c3c5;
    border-radius: 999px;
    background: linear-gradient(145deg, #b8d5e2, #dce9ed);
    box-shadow: inset 0 1px 2px rgb(53 91 106 / 18%), 0 2px 5px rgb(45 70 80 / 16%);
    isolation: isolate;
    transition: background 320ms ease, border-color 320ms ease, box-shadow 320ms ease, transform 160ms ease;
  }

  .theme-toggle:hover .theme-toggle__track {
    box-shadow: inset 0 1px 2px rgb(53 91 106 / 20%), 0 3px 8px rgb(45 70 80 / 22%);
  }

  .theme-toggle:active .theme-toggle__track {
    transform: scale(.97);
  }

  .theme-toggle__stars,
  .theme-toggle__clouds {
    position: absolute;
    inset: 0;
    transition: opacity 240ms ease, transform 320ms ease;
  }

  .theme-toggle__stars {
    opacity: 0;
    transform: translateY(-4px);
  }

  .theme-toggle__stars span {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #f2efe7;
    box-shadow: 0 0 3px rgb(242 239 231 / 70%);
  }

  .theme-toggle__stars span:nth-child(1) { left: 9px; top: 8px; }
  .theme-toggle__stars span:nth-child(2) { left: 18px; top: 18px; width: 3px; height: 3px; }
  .theme-toggle__stars span:nth-child(3) { left: 27px; top: 7px; }
  .theme-toggle__stars span:nth-child(4) { left: 33px; top: 15px; }

  .theme-toggle__cloud {
    position: absolute;
    border-radius: 999px;
    background: #faf9f5;
    box-shadow: -8px 5px 0 #faf9f5, 8px 4px 0 #faf9f5;
  }

  .theme-toggle__cloud--back {
    right: 8px;
    bottom: 5px;
    width: 18px;
    height: 8px;
    opacity: .68;
  }

  .theme-toggle__cloud--front {
    right: -1px;
    bottom: -1px;
    width: 28px;
    height: 11px;
  }

  .theme-toggle__knob {
    position: absolute;
    z-index: 2;
    top: 2px;
    left: 2px;
    width: var(--toggle-knob-size);
    height: var(--toggle-knob-size);
    border: 1px solid rgb(171 128 28 / 28%);
    border-radius: 50%;
    background: #f2c94c;
    box-shadow: 0 2px 5px rgb(122 91 17 / 28%);
    transition: transform 320ms cubic-bezier(.4, 0, .2, 1), background 320ms ease, border-color 320ms ease, box-shadow 320ms ease;
  }

  .theme-toggle__crater {
    position: absolute;
    border-radius: 50%;
    background: #aeb6c2;
    box-shadow: inset 0 1px 1px rgb(76 87 104 / 22%);
    opacity: 0;
    transition: opacity 180ms ease 100ms;
  }

  .theme-toggle__crater--large { left: 5px; bottom: 4px; width: 8px; height: 8px; }
  .theme-toggle__crater--small { right: 4px; top: 5px; width: 5px; height: 5px; }
  .theme-toggle__crater--tiny { right: 6px; bottom: 4px; width: 3px; height: 3px; }

  .theme-toggle[aria-pressed='true'] .theme-toggle__track {
    border-color: #465266;
    background: linear-gradient(145deg, #1d2940, #30384c);
    box-shadow: inset 0 1px 3px rgb(0 0 0 / 32%), 0 2px 6px rgb(5 10 18 / 38%);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__clouds {
    opacity: 0;
    transform: translateY(10px);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__stars {
    opacity: 1;
    transform: translateY(0);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__knob {
    border-color: rgb(97 109 126 / 48%);
    background: #d8dde5;
    box-shadow: 0 2px 6px rgb(2 7 15 / 45%);
    transform: translateX(var(--toggle-travel));
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__crater {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .theme-toggle {
      --toggle-knob-size: 22px;
      --toggle-travel: 24px;
      width: 60px;
      height: 44px;
      margin-left: auto;
    }

    .theme-toggle__track {
      width: 52px;
      height: 28px;
    }

    .theme-toggle__stars span:nth-child(4),
    .theme-toggle__cloud--back {
      display: none;
    }
  }
</style>
