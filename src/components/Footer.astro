---
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { localizedPath } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = ui[locale].footer;
---

<footer class="site-footer">
  <div class="shell">
    <span>© 2026 · Pitohui</span>
    <a href={localizedPath('search/', locale)}>{labels.search}</a>
    <a href={localizedPath('rss.xml', locale)}>{labels.rss}</a>
    <span>{labels.builtWith}</span>
  </div>
</footer>
