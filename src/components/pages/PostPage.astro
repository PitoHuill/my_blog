---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../TableOfContents.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { calculateReadingTime, findTranslation, getAdjacentPosts, getPublicSlug, getRelatedPosts } from '../../lib/posts';
import { localizedPath } from '../../lib/paths';

interface Props {
  locale: Locale;
  post: CollectionEntry<'posts'>;
  posts: CollectionEntry<'posts'>[];
  allPosts: CollectionEntry<'posts'>[];
}

const { locale, post, posts, allPosts } = Astro.props;
const labels = ui[locale].posts;
const { Content, headings } = await render(post);
const { previous, next } = getAdjacentPosts(posts, post.id);
const relatedPosts = getRelatedPosts(posts, post);
const targetLocale: Locale = locale === 'en' ? 'zh' : 'en';
const counterpart = findTranslation(allPosts, post, targetLocale);
const publicSlug = getPublicSlug(post.id);
const readingTime = calculateReadingTime(post.body ?? '');
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const labelSeparator = locale === 'en' ? ': ' : '：';
const href = (path: string) => localizedPath(path, locale);
const counterpartUrl = counterpart
  ? localizedPath(`posts/${getPublicSlug(counterpart.id)}/`, targetLocale)
  : undefined;
const seriesText = post.data.series
  ? locale === 'en'
    ? `${labels.series}: ${post.data.series}${post.data.seriesOrder ? ` · ${post.data.seriesOrder}` : ''}`
    : `${labels.series}：${post.data.series}${post.data.seriesOrder ? ` · 第 ${post.data.seriesOrder} 篇` : ''}`
  : undefined;
---

<BaseLayout
  title={`${post.data.title} · ${profile.name}`}
  description={post.data.description}
  locale={locale}
  canonicalPath={href(`posts/${publicSlug}/`)}
  counterpartUrl={counterpartUrl}
>
  <article class="shell article">
    <header class="article-header">
      <a class="back" href={href('posts/')}>← {labels.backToPosts}</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        {labels.published}{labelSeparator}{formatDate(post.data.pubDate)} · {labels.readingTime}{labelSeparator}{readingTime} {labels.minute}
        {post.data.tags.map((tag) => (
          <a class="tag" href={`${href('posts/')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
      {post.data.updatedDate && <div class="meta">{labels.updated}{labelSeparator}{formatDate(post.data.updatedDate)}</div>}
      {seriesText && (
        <p class="series-note">
          {post.data.seriesKey
            ? <a href={href(`series/${post.data.seriesKey}/`)}>{seriesText}</a>
            : seriesText}
        </p>
      )}
      <p class="lead">{post.data.description}</p>
    </header>

    <div class="article-layout">
      <aside class="toc-rail"><TableOfContents headings={headings} locale={locale} /></aside>
      <div class="article-body">
        <div class="article-content"><Content /></div>
        <hr />
        <nav class="article-nav" aria-label={locale === 'en' ? 'Article navigation' : '文章导航'}>
          {previous
            ? <a href={href(`posts/${getPublicSlug(previous.id)}/`)}>← {labels.previous}<br /><b>{previous.data.title}</b></a>
            : <span />}
          {next
            ? <a href={href(`posts/${getPublicSlug(next.id)}/`)}>{labels.next} →<br /><b>{next.data.title}</b></a>
            : <span />}
        </nav>
        {relatedPosts.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 class="section-heading" id="related-heading">{labels.relatedPosts}</h2>
            <div class="related-grid">
              {relatedPosts.map((related) => (
                <article class="related-card">
                  <div class="meta">{formatDate(related.data.pubDate)}</div>
                  <h3><a href={href(`posts/${getPublicSlug(related.id)}/`)}>{related.data.title}</a></h3>
                  <p>{related.data.description}</p>
                </article>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article{max-width:1020px;padding-top:64px}.article-header{max-width:720px;margin:0 0 40px}.back{display:inline-flex;align-items:center;min-height:44px;font-size:.85rem}.article h1{font:2.55rem/1.25 Georgia,"Noto Serif SC",serif;letter-spacing:-.025em;text-wrap:balance;margin:20px 0 16px}.series-note{display:inline-block;margin:16px 0 0;padding:7px 10px;background:var(--color-soft);border:1px solid var(--color-border);border-radius:4px;color:var(--color-muted);font-size:.82rem}.series-note a{color:var(--color-accent)}.lead{max-width:65ch;margin:24px 0 0;padding-top:20px;border-top:1px solid var(--color-border);color:var(--color-muted);font:1.08rem/1.75 Georgia,"Noto Serif SC",serif}.article-layout{display:grid;grid-template-columns:minmax(0,720px) 220px;grid-template-areas:"body toc";justify-content:center;gap:64px;align-items:start}.article-body{grid-area:body;min-width:0}.toc-rail{grid-area:toc;position:sticky;top:88px;min-width:0}.article hr{border:0;border-top:1px solid var(--color-border);margin:48px 0}.article-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.article-nav a{min-width:0;overflow-wrap:anywhere;color:var(--color-muted);line-height:1.55}.article-nav a:last-child{text-align:right}.article-nav b{color:var(--color-text);font:1rem Georgia,"Noto Serif SC",serif}.related{margin-top:64px}.related-grid{border-top:1px solid var(--color-border)}.related-card{padding:20px 0;border-bottom:1px solid var(--color-border)}.related-card h3{font:1.05rem/1.45 Georgia,"Noto Serif SC",serif;margin:6px 0}.related-card h3 a{color:var(--color-text)}.related-card p{max-width:62ch;color:var(--color-muted);font-size:.84rem;line-height:1.65;margin:0}@media(max-width:767px){.article{padding-top:40px}.article-header{margin-bottom:32px}.article h1{font-size:1.9rem}.article-layout{grid-template-columns:1fr;grid-template-areas:"toc" "body";gap:24px}.toc-rail{position:static}.article-nav{grid-template-columns:1fr}.article-nav a:last-child{text-align:left}.article-nav span:empty{display:none}.related{margin-top:48px}}
  .article{max-width:1004px}
  @media(max-width:1023px){.article-layout{grid-template-columns:minmax(0,720px);grid-template-areas:"toc" "body";gap:28px}.toc-rail{position:static}.table-of-contents{max-width:720px}.article-body>:first-child{margin-top:0}}
</style>
