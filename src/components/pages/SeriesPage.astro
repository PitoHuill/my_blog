---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import type { PostSeries } from '../../lib/post-utils';
import { getPublicSlug } from '../../lib/posts';
import { localizedPath } from '../../lib/paths';

interface Props {
  locale: Locale;
  series: PostSeries<CollectionEntry<'posts'>>;
  hasCounterpart: boolean;
}

const { locale, series, hasCounterpart } = Astro.props;
const labels = ui[locale].series;
const href = (path: string) => localizedPath(path, locale);
const targetLocale: Locale = locale === 'en' ? 'zh' : 'en';
const counterpartUrl = hasCounterpart ? localizedPath(`series/${series.key}/`, targetLocale) : undefined;
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const articleLabel = series.posts.length === 1 ? labels.article : labels.articles;
---

<BaseLayout
  title={`${series.title} · ${profile.name}`}
  description={series.posts[0].data.description}
  locale={locale}
  canonicalPath={href(`series/${series.key}/`)}
  counterpartUrl={counterpartUrl}
>
  <section class="shell series-page">
    <a class="back" href={href('series/')}>← {labels.backToSeries}</a>
    <p class="eyebrow">{labels.eyebrow}</p>
    <h1>{series.title}</h1>
    <p class="series-description">{series.posts[0].data.description}</p>
    <div class="series-summary card">
      <span><b>{series.posts.length}</b>{articleLabel}</span>
      <span><b>{formatDate(series.latestDate)}</b>{labels.latestUpdate}</span>
    </div>

    <div class="section-heading">{labels.chapters}</div>
    <ol class="chapter-list">
      {series.posts.map((post, index) => (
        <li class="chapter card">
          <span class="chapter__number">{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
          <div>
            <div class="meta">{formatDate(post.data.pubDate)}</div>
            <h2><a href={href(`posts/${getPublicSlug(post.id)}/`)}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </div>
          <span class="chapter__arrow" aria-hidden="true">→</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .series-page{max-width:820px;padding-top:50px}.back{font-size:.85rem}.series-page>.eyebrow{margin-top:2.4rem}.series-page h1{font:2.35rem/1.3 Georgia,"Noto Serif SC",serif;margin:.6rem 0}.series-description{max-width:650px;color:var(--color-muted);font-size:1.02rem;line-height:1.75}.series-summary{display:flex;gap:40px;padding:18px 22px;margin:28px 0 38px}.series-summary span{display:flex;flex-direction:column;color:var(--color-muted);font-size:.76rem}.series-summary b{color:var(--color-accent);font:1.1rem Georgia,"Noto Serif SC",serif;margin-bottom:.25rem}.chapter-list{list-style:none;padding:0;margin:0}.chapter{display:grid;grid-template-columns:48px minmax(0,1fr) 24px;gap:14px;align-items:start;padding:21px;margin-bottom:13px}.chapter__number{color:var(--color-accent);font:1.15rem Georgia}.chapter h2{font:1.12rem/1.45 Georgia,"Noto Serif SC",serif;margin:.35rem 0}.chapter h2 a{color:var(--color-text)}.chapter p{color:var(--color-muted);font-size:.86rem;line-height:1.65;margin:.4rem 0 0}.chapter__arrow{align-self:center;font-size:1.2rem}@media(max-width:600px){.series-page{padding-top:30px}.series-page h1{font-size:1.9rem}.series-summary{gap:22px}.chapter{grid-template-columns:36px minmax(0,1fr);padding:18px}.chapter__arrow{display:none}}
</style>
