---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import type { PostSeries } from '../../lib/post-utils';
import { getPublicSlug } from '../../lib/posts';
import { localizedPath } from '../../lib/paths';

interface Props {
  locale: Locale;
  series: PostSeries<CollectionEntry<'posts'>>;
  hasCounterpart: boolean;
}

const { locale, series, hasCounterpart } = Astro.props;
const labels = ui[locale].series;
const href = (path: string) => localizedPath(path, locale);
const targetLocale: Locale = locale === 'en' ? 'zh' : 'en';
const counterpartUrl = hasCounterpart ? localizedPath(`series/${series.key}/`, targetLocale) : undefined;
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const articleLabel = series.posts.length === 1 ? labels.article : labels.articles;
---

<BaseLayout
  title={`${series.title} · ${profile.name}`}
  description={series.posts[0].data.description}
  locale={locale}
  canonicalPath={href(`series/${series.key}/`)}
  counterpartUrl={counterpartUrl}
>
  <section class="shell series-page">
    <a class="back" href={href('series/')}>← {labels.backToSeries}</a>
    <h1>{series.title}</h1>
    <p class="series-description">{series.posts[0].data.description}</p>
    <div class="series-summary">
      <span><b>{series.posts.length}</b>{articleLabel}</span>
      <span><b>{formatDate(series.latestDate)}</b>{labels.latestUpdate}</span>
    </div>

    <h2 class="section-heading">{labels.chapters}</h2>
    <ol class="chapter-list">
      {series.posts.map((post, index) => (
        <li class="chapter">
          <span class="chapter__number">{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
          <div>
            <div class="meta">{formatDate(post.data.pubDate)}</div>
            <h2><a href={href(`posts/${getPublicSlug(post.id)}/`)}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </div>
          <span class="chapter__arrow" aria-hidden="true">→</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .series-page{max-width:820px;padding-top:64px}.back{display:inline-flex;align-items:center;min-height:44px;font-size:.85rem}.series-page h1{font:2.45rem/1.25 Georgia,"Noto Serif SC",serif;letter-spacing:-.02em;margin:20px 0 12px}.series-description{max-width:650px;margin:0;color:var(--color-muted);font-size:1.02rem;line-height:1.75}.series-summary{display:flex;gap:48px;padding:20px 0;margin:32px 0 48px;border-block:1px solid var(--color-border)}.series-summary span{display:flex;flex-direction:column;color:var(--color-muted);font-size:.76rem}.series-summary b{color:var(--color-accent);font:1.1rem Georgia,"Noto Serif SC",serif;margin-bottom:.25rem}.chapter-list{list-style:none;padding:0;margin:0;border-top:1px solid var(--color-border)}.chapter{display:grid;grid-template-columns:56px minmax(0,1fr) 32px;gap:16px;align-items:start;padding:24px 0;border-bottom:1px solid var(--color-border)}.chapter__number{color:var(--color-accent);font:1.15rem Georgia,"Noto Serif SC",serif}.chapter h2{font:1.16rem/1.45 Georgia,"Noto Serif SC",serif;margin:4px 0 0}.chapter h2 a{color:var(--color-text)}.chapter p{max-width:62ch;color:var(--color-muted);font-size:.86rem;line-height:1.7;margin:8px 0 0}.chapter__arrow{align-self:center;font-size:1.2rem}@media(max-width:767px){.series-page{padding-top:40px}.series-page h1{font-size:1.9rem}.series-summary{gap:24px;margin:24px 0 40px}.chapter{grid-template-columns:36px minmax(0,1fr);padding:22px 0}.chapter__arrow{display:none}}
</style>
