---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { getPostSeries } from '../../lib/posts';
import { localizedPath } from '../../lib/paths';

interface Props {
  locale: Locale;
  posts: CollectionEntry<'posts'>[];
}

const { locale, posts } = Astro.props;
const labels = ui[locale].series;
const series = getPostSeries(posts);
const href = (path: string) => localizedPath(path, locale);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const articleLabel = (count: number) => count === 1 ? labels.article : labels.articles;
---

<BaseLayout
  title={`${labels.title} · ${profile.name}`}
  description={labels.description}
  locale={locale}
  canonicalPath={href('series/')}
  counterpartUrl={localizedPath('series/', locale === 'en' ? 'zh' : 'en')}
>
  <section class="shell series-index">
    <div class="series-intro">
      <div>
        <h1>{labels.title}</h1>
        <p>{labels.description}</p>
      </div>
      <span>{series.length} {series.length === 1 ? labels.collection : labels.collections}</span>
    </div>

    <div class="series-grid">
      {series.length ? series.map((item) => (
        <article class="series-card">
          <div class="series-card__meta">
            <span>{item.posts.length} {articleLabel(item.posts.length)}</span>
            <span>{labels.latestUpdate} · {formatDate(item.latestDate)}</span>
          </div>
          <h2><a href={href(`series/${item.key}/`)}>{item.title}</a></h2>
          <p>{item.posts[0].data.description}</p>
          <ol>
            {item.posts.slice(0, 3).map((post) => <li>{post.data.title}</li>)}
          </ol>
          <a class="series-card__link" href={href(`series/${item.key}/`)}>
            {labels.chapters} →
          </a>
        </article>
      )) : <p class="empty-state">{locale === 'en' ? 'No article series have been published yet.' : '暂时还没有已发布的文章系列。'}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .series-index{max-width:900px;padding-top:64px}.series-intro{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:40px}.series-intro h1{font:2.35rem/1.25 Georgia,"Noto Serif SC",serif;letter-spacing:-.02em;margin:0 0 12px}.series-intro p{max-width:580px;color:var(--color-muted);line-height:1.7;margin:0}.series-intro>span{white-space:nowrap;color:var(--color-accent);font:1rem Georgia,"Noto Serif SC",serif}.series-grid{border-top:1px solid var(--color-border)}.empty-state{margin:0;padding:32px 0;color:var(--color-muted);line-height:1.7}.series-card{display:grid;grid-template-columns:160px minmax(0,1fr) 120px;gap:24px;padding:28px 0;border-bottom:1px solid var(--color-border)}.series-card__meta{display:grid;align-content:start;gap:6px;color:var(--color-muted);font-size:.76rem;font-variant-numeric:tabular-nums}.series-card h2{font:1.4rem/1.4 Georgia,"Noto Serif SC",serif;margin:0 0 8px}.series-card h2 a{color:var(--color-text)}.series-card>p{grid-column:2;max-width:60ch;color:var(--color-muted);font-size:.88rem;line-height:1.7;margin:0}.series-card ol{grid-column:2;margin:12px 0 0;padding-left:1.2rem;color:var(--color-muted);font-size:.82rem;line-height:1.75}.series-card__link{grid-column:3;grid-row:1/4;align-self:center;justify-self:end;font-size:.84rem}@media(max-width:767px){.series-index{padding-top:40px}.series-intro{align-items:start;flex-direction:column;gap:12px}.series-intro h1{font-size:1.9rem}.series-card{grid-template-columns:1fr;gap:10px;padding:24px 0}.series-card__meta{display:flex;flex-wrap:wrap;gap:8px 16px}.series-card>p,.series-card ol,.series-card__link{grid-column:1}.series-card__link{grid-row:auto;justify-self:start;min-height:44px;display:flex;align-items:center}}
</style>
