---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { getPublicSlug, getPublishedPosts } from '../../lib/posts';
import { localizedPath } from '../../lib/paths';

interface Props { locale: Locale }

const { locale } = Astro.props;
const labels = ui[locale];
const posts = await getPublishedPosts(locale);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const href = (path: string) => localizedPath(path, locale);
---

<BaseLayout
  title={`${labels.posts.title} · ${profile.name}`}
  description={labels.posts.description}
  locale={locale}
  canonicalPath={href('posts/')}
  counterpartUrl={localizedPath('posts/', locale === 'en' ? 'zh' : 'en')}
>
  <section class="shell listing post-listing">
    <h1
      id="posts-heading"
      data-default-title={labels.posts.title}
      data-tag-prefix={`${labels.posts.tags}${locale === 'en' ? ': ' : '：'}`}
    >{labels.posts.title}</h1>
    <p class="intro">{labels.posts.description}</p>
    <a class="series-link" href={href('series/')}>{labels.posts.browseSeries} →</a>
    <nav class="tags" aria-label={locale === 'en' ? 'Filter articles by tag' : '按标签筛选文章'}>
      <a href={href('posts/')} data-filter-tag="" aria-controls="post-entry-list">{locale === 'en' ? 'All' : '全部'}</a>
      {tags.map((tag) => <a href={`${href('posts/')}?tag=${encodeURIComponent(tag)}`} data-filter-tag={tag} aria-controls="post-entry-list">{tag}</a>)}
    </nav>
    <div class="entry-list" id="post-entry-list">
      {posts.map((post) => (
        <article class="entry" data-post-entry data-tags={JSON.stringify(post.data.tags)}>
          <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          <div>
            <h2><a href={href(`posts/${getPublicSlug(post.id)}/`)}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="meta">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
    <p class="filter-empty" data-filter-empty role="status" aria-live="polite" hidden>
      {posts.length === 0
        ? (locale === 'en' ? 'No articles have been published yet.' : '暂时还没有已发布文章。')
        : (locale === 'en' ? 'No articles under this tag yet.' : '这个标签下暂时没有文章。')}
    </p>
  </section>
</BaseLayout>

<script>
  const listing = document.querySelector('.post-listing');
  const heading = listing?.querySelector('#posts-heading');
  const selectedTag = new URLSearchParams(window.location.search).get('tag') ?? '';

  if (listing && heading instanceof HTMLElement) {
    const defaultTitle = heading.dataset.defaultTitle ?? '';
    const tagPrefix = heading.dataset.tagPrefix ?? '';
    heading.textContent = selectedTag ? `${tagPrefix}${selectedTag}` : defaultTitle;

    listing.querySelectorAll<HTMLElement>('[data-post-entry]').forEach((entry) => {
      const tags = JSON.parse(entry.dataset.tags ?? '[]');
      entry.hidden = Boolean(selectedTag) && !tags.includes(selectedTag);
    });

    const visibleCount = [...listing.querySelectorAll<HTMLElement>('[data-post-entry]')]
      .filter((entry) => !entry.hidden).length;
    const empty = listing.querySelector<HTMLElement>('[data-filter-empty]');
    if (empty) empty.hidden = visibleCount > 0;

    listing.querySelectorAll<HTMLAnchorElement>('[data-filter-tag]').forEach((link) => {
      if ((link.dataset.filterTag ?? '') === selectedTag) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }
</script>

<style>
  .listing{max-width:820px;padding-top:64px}.listing h1{font:2.35rem/1.25 Georgia,"Noto Serif SC",serif;letter-spacing:-.02em;margin:0 0 12px}.intro{max-width:64ch;margin:0;color:var(--color-muted);line-height:1.7}.series-link{display:inline-flex;align-items:center;min-height:44px;margin-top:8px;font-size:.86rem}.tags{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0 32px}.tags a{border:1px solid var(--color-border);background:transparent;padding:7px 10px;border-radius:4px;font-size:.8rem}.tags a[aria-current='page']{border-color:var(--color-accent);color:var(--color-text);background:var(--color-soft)}.entry-list{border-top:1px solid var(--color-border)}.entry{display:grid;grid-template-columns:112px minmax(0,1fr);gap:24px;padding:24px 0;border-bottom:1px solid var(--color-border)}.entry time{padding-top:4px;color:var(--color-muted);font-size:.78rem;font-variant-numeric:tabular-nums}.entry h2{font:1.2rem/1.45 Georgia,"Noto Serif SC",serif;margin:0}.entry h2 a{color:var(--color-text)}.entry p{max-width:62ch;margin:8px 0;color:var(--color-muted);font-size:.9rem;line-height:1.7}.entry .tag:first-child{margin-left:0}.filter-empty{padding:32px 0;color:var(--color-muted)}@media(max-width:767px){.listing{padding-top:40px}.listing h1{font-size:1.9rem}.entry{grid-template-columns:1fr;gap:6px;padding:22px 0}}
</style>
