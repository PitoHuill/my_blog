---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { localizedPath } from '../../lib/paths';
import { getPublishedPosts } from '../../lib/posts';
import { buildSearchIndex, serializeSearchPayload } from '../../lib/search';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = ui[locale].search;
const posts = await getPublishedPosts(locale);
const searchable = buildSearchIndex(posts, locale);
const counterpartLocale = locale === 'en' ? 'zh' : 'en';
const searchPayload = serializeSearchPayload({
  searchable,
  locale,
  resultSingular: labels.resultSingular,
  resultLabel: labels.results,
  initialMessage: labels.initialMessage,
  noResults: labels.noResults,
});
---

<BaseLayout
  title={`${labels.title} · ${profile.name}`}
  description={labels.description}
  locale={locale}
  canonicalPath={localizedPath('search/', locale)}
  counterpartUrl={localizedPath('search/', counterpartLocale)}
>
  <section class="shell search-page">
    <h1>{labels.title}</h1>
    <label for="site-search">{labels.inputLabel}</label>
    <input id="site-search" type="search" placeholder={labels.placeholder} autocomplete="off" aria-controls="results" aria-describedby="result-count" />
    <p id="result-count" class="meta" aria-live="polite">{labels.initialMessage}</p>
    <div id="results" aria-label={locale === 'en' ? 'Search results' : '搜索结果'}></div>
    <noscript><p class="search-empty">{locale === 'en' ? 'Enable JavaScript to search this archive.' : '请启用 JavaScript 以搜索文章档案。'}</p></noscript>
    <script id="search-data" type="application/json" set:html={searchPayload}></script>
  </section>
</BaseLayout>

<script>
  const payloadElement = document.querySelector('#search-data');
  const payload = JSON.parse(payloadElement?.textContent ?? 'null');
  const { searchable, locale, resultSingular, resultLabel, initialMessage, noResults } = payload;
  const input = document.querySelector('#site-search');
  const results = document.querySelector('#results');
  const count = document.querySelector('#result-count');

  const createResult = (post) => {
    const article = document.createElement('article');
    article.className = 'result';

    const heading = document.createElement('h2');
    const link = document.createElement('a');
    link.href = post.url;
    link.textContent = post.title;
    heading.append(link);

    const meta = document.createElement('div');
    meta.className = 'result__meta';

    const date = document.createElement('time');
    date.className = 'result__date';
    date.dateTime = post.date;
    date.textContent = post.date;
    meta.append(date);

    if (post.tags.length > 0) {
      const tags = document.createElement('div');
      tags.className = 'result__tags';
      for (const tag of post.tags) {
        const tagElement = document.createElement('span');
        tagElement.className = 'result__tag';
        tagElement.textContent = tag;
        tags.append(tagElement);
      }
      meta.append(tags);
    }

    const description = document.createElement('p');
    description.className = 'result__description';
    description.textContent = post.description;
    article.append(heading, meta, description);
    return article;
  };

  const createEmptyState = () => {
    const message = document.createElement('p');
    message.className = 'search-empty';
    message.textContent = noResults;
    return message;
  };

  if (input instanceof HTMLInputElement && results && count) {
    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      const matches = query
        ? searchable.filter((post) => `${post.title} ${post.description} ${post.tags.join(' ')}`.toLowerCase().includes(query))
        : [];
      count.textContent = query
        ? locale === 'en'
          ? `${matches.length} ${matches.length === 1 ? resultSingular : resultLabel}`
          : `找到 ${matches.length} ${matches.length === 1 ? resultSingular : resultLabel}`
        : initialMessage;
      results.replaceChildren(...(query && matches.length === 0 ? [createEmptyState()] : matches.map(createResult)));
    });
  }
</script>

<style is:global>
  .search-page{max-width:820px;padding-top:64px}.search-page h1{font:2.35rem/1.25 Georgia,"Noto Serif SC",serif;letter-spacing:-.02em;margin:0 0 24px}.search-page label{display:block;font-size:.88rem;margin-bottom:8px}.search-page input{width:100%;padding:14px 16px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);border-radius:6px;font:1rem system-ui;transition:border-color .18s ease-out,box-shadow .18s ease-out}.search-page input:focus{border-color:var(--color-accent);outline:0;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-accent) 14%,transparent)}.search-page #result-count{margin:16px 0 24px}.search-page #results{border-top:1px solid var(--color-border)}.search-page .result{min-width:0;padding:24px 0;border-bottom:1px solid var(--color-border)}.search-page .result h2{font:1.08rem/1.45 Georgia,"Noto Serif SC",serif;margin:0 0 8px;overflow-wrap:anywhere}.search-page .result h2 a{color:var(--color-text)}.search-page .result h2 a:hover{color:var(--color-accent)}.search-page .result__meta{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;color:var(--color-muted);font-size:.78rem}.search-page .result__date{font-variant-numeric:tabular-nums}.search-page .result__tags{display:flex;flex-wrap:wrap;gap:6px}.search-page .result__tag{padding:2px 7px;background:var(--color-soft);border:1px solid var(--color-border);border-radius:3px;line-height:1.35}.search-page .result__description{max-width:66ch;margin:12px 0 0;color:var(--color-muted);font-size:.88rem;line-height:1.7}.search-page .search-empty{margin:0;padding:32px 0;color:var(--color-muted);line-height:1.7}@media(max-width:767px){.search-page{padding-top:40px}.search-page h1{font-size:1.9rem}.search-page .result{padding:22px 0}}
</style>
