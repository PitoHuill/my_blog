---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/config';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  canonicalPath: string;
  counterpartUrl?: string;
}

const { title, description, locale, canonicalPath, counterpartUrl } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const counterpartAbsoluteUrl = counterpartUrl ? new URL(counterpartUrl, Astro.site) : undefined;
const englishUrl = locale === 'en' ? canonicalUrl : counterpartAbsoluteUrl;
const chineseUrl = locale === 'zh' ? canonicalUrl : counterpartAbsoluteUrl;
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {chineseUrl && <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />}
    {englishUrl && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <script is:inline>const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');</script>
  </head>
  <body>
    <Header locale={locale} counterpartUrl={counterpartUrl} />
    <main id="content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
